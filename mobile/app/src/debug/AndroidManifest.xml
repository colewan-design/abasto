<?xml version="1.0" encoding="utf-8"?>
<!--
    Merged into the debug build only. It exists so that pointing the app at a
    local API over plain HTTP works without weakening what ships: the release
    manifest has no network security config, so cleartext stays blocked there.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig" />
</manifest>
