<?xml version="1.0" encoding="utf-8"?>
<!--
    The mark on its own plate: the plate carries the artwork's dark and the
    warm light at the foot of it, the mark sits inside the 72dp safe zone so
    no launcher's mask can clip it, and the monochrome layer is the same
    silhouette for the themed icons Android 13 asks for.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
